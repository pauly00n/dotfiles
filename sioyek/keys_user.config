# zathura-style binds. format: command_name  key
# NOTE: screen_up/down are FULL screen (sioyek has no half-page)
screen_up                  u
screen_down                d

# zoom (zathura had K=in, J=out)
zoom_in                    K
zoom_out                   J

# reload (sioyek also auto-reloads on file change by default)
reload                     r

# recolor toggle (zathura `i`)
toggle_dark_mode           i
