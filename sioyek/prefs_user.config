# gruvbox-ish, matched to old zathura config
# surround/background behind pages (#0E1018)
background_color            0.055 0.063 0.094

# colors used by `toggle_dark_mode` custom path (bound to `i` below)
# bg #0E1018, text #ebdbb2
custom_background_color     0.055 0.063 0.094
custom_text_color          0.922 0.859 0.698

# view the pdf as-is by default (zathura had recolor=false)
default_dark_mode          0

# toggle_dark_mode look (bound to `i`), matched to old zathura recolor:
# bg #1c1c1c (was pure black), full-white inversion (was dimmed to 0.8)
dark_mode_background_color 0.110 0.110 0.110
dark_mode_contrast         1.0

# finer steps: j/k scroll (default 1.0) and J/K zoom (default 1.2)
vertical_move_amount       0.5
zoom_inc_factor            1.1
