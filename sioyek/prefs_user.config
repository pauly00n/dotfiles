# gruvbox-ish, matched to old zathura config
# surround/background behind pages - light gray so the dark page pops (#e0e0e0)
background_color            0.88 0.88 0.88

# the actual "dark mode" -> `toggle_custom_color` (bound to `i`)
custom_background_color     0.1 0.1 0.1
custom_text_color          0.9 0.9 0.9

# view the pdf as-is by default (zathura had recolor=false)
default_dark_mode          0

# toggle_dark_mode look (bound to `i`), matched to old zathura recolor:
# bg #1c1c1c (was pure black), full-white inversion (was dimmed to 0.8)
dark_mode_background_color 1.0 1.0 1.0
dark_mode_contrast         0.9

# finer steps: j/k scroll (default 1.0) and J/K zoom (default 1.2)
vertical_move_amount       0.5
zoom_inc_factor            1.1
